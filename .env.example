# ==========================================
# FCKIT E-Commerce Environment Configuration
# ==========================================

# Server port (Render sets PORT automatically)
PORT=5500

# Node environment: 'development' or 'production'
NODE_ENV=production

# Telegram bot token for admin order notifications
# Obtain via @BotFather
TELEGRAM_BOT_TOKEN=your_admin_telegram_bot_token_here

# Admin Telegram Chat ID where new order alerts will be sent
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Customer-facing Telegram bot token (optional, for webapp / customer updates)
TELEGRAM_CUSTOMER_BOT_TOKEN=your_customer_bot_token_here

# Admin panel authentication password
# Set a strong, unique secret password for /admin.html access
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Secret key used for signing admin HMAC session tokens (min 32 chars)
ADMIN_JWT_SECRET=change_this_to_a_long_random_jwt_secret_key_32_chars_minimum

# Allowed CORS origins (comma-separated, without trailing slashes)
# Example: https://creatoraia29-ops.github.io,https://fckit.onrender.com
ALLOWED_ORIGINS=https://creatoraia29-ops.github.io,https://fckit.onrender.com,http://localhost:5500,http://127.0.0.1:5500

# Turso Cloud SQLite Database (Optional - falls back to local sqlite if not set)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Google Gemini API Key (optional, for AI fashion assistant)
# GEMINI_API_KEY=your_gemini_api_key_here
